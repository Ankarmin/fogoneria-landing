# Resend (envío de correos del formulario de cotizaciones)
# Las tres variables son obligatorias: sin ellas /api/cotizacion responde 500.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_TO_EMAIL=cotizaciones@tudominio.com
# En Vercel pegá este valor SIN comillas: Vercel las guarda literalmente.
# onboarding@resend.dev solo puede enviar al email titular de la cuenta de Resend.
# Para producción, verificá un dominio propio y usá un remitente de ese dominio.
RESEND_FROM_EMAIL=Fogonería <onboarding@resend.dev>

# URL pública del landing (canonical, OG y sitemap)
# Default: https://fogoneria-landing.vercel.app
# PUBLIC_SITE_URL=https://fogoneria-landing.vercel.app

# URL del sistema principal (auth, onboarding, términos)
# Default dev: http://localhost:3000 | Default prod: https://fogoneria-system.vercel.app
# PUBLIC_ORIGIN_URL=https://fogoneria-system.vercel.app
