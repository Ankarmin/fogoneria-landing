# Resend (envío de correos del formulario de cotizaciones)
# Las tres variables son obligatorias: sin ellas /api/cotizacion responde 500.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_TO_EMAIL=cotizaciones@tudominio.com
# En Vercel pegá este valor SIN comillas: Vercel las guarda literalmente.
RESEND_FROM_EMAIL=Fogonería <onboarding@resend.dev>

