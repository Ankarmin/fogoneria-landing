---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/landing/Hero.astro";
import QuienesSomos from "../components/landing/QuienesSomos.astro";
import Funcionalidades from "../components/landing/Funcionalidades.astro";
import Testimonials from "../components/landing/Testimonials.astro";
import Cotizaciones from "../components/landing/Cotizaciones.astro";
import Faq from "../components/landing/Faq.astro";
import SectionDivider from "../components/ui/SectionDivider.astro";
---

<BaseLayout>
  <main class="bg-surface dark:bg-black min-h-screen w-full overflow-x-clip">
    <Navbar />
    <div class="pt-16">
      <Hero />
      <SectionDivider />
      <QuienesSomos />
      <SectionDivider />
      <Funcionalidades />
      <SectionDivider />
      <Testimonials />
      <SectionDivider />
      <Cotizaciones />
      <SectionDivider />
      <Faq />
    </div>
    <SectionDivider />
    <Footer />
  </main>
</BaseLayout>
