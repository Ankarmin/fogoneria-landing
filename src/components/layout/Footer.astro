---
import { ORIGIN_URLS } from "../../lib/site";
---

<footer class="bg-persimmon-950 text-white pt-12 pb-8">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-2">
          <span class="w-8 h-8 rounded-xl bg-surface text-ink-900 flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
          </span>
          <span class="text-sm font-medium text-white">Fogonería</span>
        </div>
        <p class="text-sm leading-relaxed text-white/60">
          Fogonería, el lugar donde cocinamos tu negocio.
        </p>
      </div>

      <div>
        <h3 class="text-white font-medium mb-4 uppercase text-xs">Plataforma</h3>
        <ul class="flex flex-col gap-2 text-nav text-white/60">
          <li><a href="#inicio" class="hover:text-white transition-colors px-0 py-2">Inicio</a></li>
          <li><a href="#demos" class="hover:text-white transition-colors px-0 py-2">Ver Demos</a></li>
          <li><a href="#how-it-works" class="hover:text-white transition-colors px-0 py-2">Cómo funciona</a></li>
          <li><a href="#pricing" class="hover:text-white transition-colors px-0 py-2">Precios y Planes</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-white font-medium mb-4 uppercase text-xs">Soporte</h3>
        <ul class="flex flex-col gap-2 text-nav text-white/60">
          <li><a href="#" class="hover:text-white transition-colors">Centro de Ayuda</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Preguntas Frecuentes</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Tutoriales</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-white font-medium mb-4 uppercase text-xs">Comunícate</h3>
        <ul class="flex flex-col gap-3 text-sm text-white/60">
          <li class="flex items-start gap-2">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="shrink-0 mt-0.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            <span>hola@fogoneria.com</span>
          </li>
          <li class="flex items-start gap-2">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="shrink-0 mt-0.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            <span>+51 987 654 321</span>
          </li>
          <li class="flex items-start gap-2">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="shrink-0 mt-0.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <span>Lima, Perú</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t border-white/10 flex flex-col-reverse md:flex-row justify-between items-center gap-4">
      <div class="text-xs text-white/40 flex flex-col sm:flex-row gap-2 sm:gap-4 items-center">
        <span>© 2026 Fogonería. Todos los derechos reservados.</span>
        <a href={ORIGIN_URLS.terminos} target="_blank" rel="noopener" class="hover:text-white transition-colors">
          Políticas, términos y condiciones
        </a>
      </div>
    </div>
  </div>
</footer>
