---
import { cn } from "../../lib/cn";

interface Props {
  class?: string;
  href?: string;
  as?: "div" | "article" | "section" | "aside";
}

const { class: className = "", href, as: Tag = "div" } = Astro.props;
const cls = cn("bg-surface rounded-2xl border border-ink-900/10 p-4", className);
---

{
  href !== undefined ? (
    <a href={href} class={cls}>
      <slot />
    </a>
  ) : (
    <Tag class={cls}>
      <slot />
    </Tag>
  )
}
