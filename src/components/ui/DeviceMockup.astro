---
/** Laptop CSS pura con pantalla vacía lista para screenshot futuro.
 *  Badge flotante estilo referencia (igual día/noche).
 */
interface Props {
  badge: string;
  phone?: boolean;
}

const { badge, phone = false } = Astro.props;
---

<div class="relative w-full max-w-xl mx-auto pb-6">
  {/* Laptop */}
  <div aria-hidden="true" class="rounded-2xl border bg-ink-900 dark:bg-black border-ink-900 dark:border-white/15 p-2">
    <div class="relative overflow-hidden rounded-xl">
      <div class="aspect-video rounded-xl bg-surface dark:bg-white/5 flex items-center justify-center relative">
        {/* Notch / cámara: pastilla centrada arriba */}
        <span class="absolute top-2 left-1/2 -translate-x-1/2 h-1.5 w-16 rounded-full bg-ink-900/15 dark:bg-white/15"></span>
        <span class="absolute top-2.5 left-1/2 translate-x-6 h-1 w-1 rounded-full bg-ink-900/20 dark:bg-white/20"></span>
        {/* Watermark centrado */}
        <svg
          width="48"
          height="48"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-ink-900/10 dark:text-white/10"
          aria-hidden="true"
        >
          <path
            d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"
          ></path>
        </svg>
        <!-- SCREENSHOT: reemplazar este div por el <Image> real de la app -->
      </div>
    </div>
  </div>
  {/* Base de laptop: barra inferior */}
  <div aria-hidden="true" class="mx-auto h-2 w-[92%] rounded-b-xl bg-ink-900/70 dark:bg-white/10"></div>
  <div aria-hidden="true" class="mx-auto h-1 w-[60%] rounded-b-lg bg-ink-900/10 dark:bg-white/10"></div>

  {phone ? (
    <div
      aria-hidden="true"
      class="absolute -bottom-0 right-2 sm:right-6 w-20 sm:w-24 rounded-2xl border bg-ink-900 dark:bg-black border-ink-900 dark:border-white/15 p-1 shadow-xl"
    >
      <div class="relative overflow-hidden rounded-xl">
        <div class="aspect-[9/19] rounded-xl bg-surface dark:bg-white/5 flex items-center justify-center relative">
          <span class="absolute top-1.5 left-1/2 -translate-x-1/2 h-1 w-8 rounded-full bg-ink-900/15 dark:bg-white/15"></span>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-ink-900/10 dark:text-white/10"
            aria-hidden="true"
          >
            <path
              d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"
            ></path>
          </svg>
        </div>
      </div>
    </div>
  ) : null}

  {/* Badge flotante abajo-izquierda */}
  <div class="absolute bottom-0 left-2 sm:left-6 inline-flex max-w-[calc(100%-6rem)] items-center gap-2 rounded-full bg-white text-ink-900 border border-ink-900/10 shadow-lg px-3 py-2">
    <span class="relative flex h-2 w-2 shrink-0" aria-hidden="true">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
    </span>
    <span class="text-xs font-medium truncate">{badge}</span>
  </div>
</div>
