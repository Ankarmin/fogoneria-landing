---
/** Título sección 24px medium + subtítulo 14px + eyebrow 12px (tokens adaptativos).
 *  Variante `display` (opt-in): titular HUD cinematográfico en mayúsculas
 *  con --text-display-sm. Claro por defecto, override `dark:`.
 *  El punto vivo persimmon del eyebrow display funciona en ambos modos.
 */
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "center" | "left";
  display?: boolean;
}

const { eyebrow, title, description, align = "center", display = false } = Astro.props;
const alignCls = align === "center" ? "text-center mx-auto" : "text-left";
const titleCls = display
  ? "font-display uppercase text-display-sm leading-display tracking-display text-ink-900 dark:text-white"
  : "text-section font-medium leading-tight text-ink-900 dark:text-white";
---

<div class={`max-w-2xl mb-8 sm:mb-10 px-0 min-w-0 ${alignCls}`}>
  {
    eyebrow ? (
      <p class={`font-medium uppercase text-xs tracking-widest mb-3 flex items-center gap-2 ${align === "center" ? "justify-center" : "justify-start"} text-ink-400 dark:text-white/50`}>
        {display ? (
          <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse" aria-hidden="true" />
        ) : null}
        <span>{eyebrow}</span>
      </p>
    ) : null
  }
  <h2 class:list={[titleCls, "text-balance", "break-words"]}>
    {display ? (
      <span class={`block w-14 h-1 bg-primary rounded-full mb-4 ${align === "center" ? "mx-auto" : ""}`} aria-hidden="true" />
    ) : null}
    {title}
  </h2>
  {
    description ? (
      <p class="text-sm mt-3 leading-relaxed text-ink-600 dark:text-white/70">{description}</p>
    ) : null
  }
</div>
