---
/**
 * ThemeToggle — Botón modo oscuro/claro.
 * Copia exacta del ERP (fogoneria/apps/web/components/dashboard/AppTopBar.tsx:123-131):
 * Moon/Sun de lucide-react v1.43.0, size 14, mismo botón
 * p-2 rounded-full text-ink-400 hover:text-ink-900 hover:bg-primary-hover/[0.05]
 * + mismo aria-label. Persiste en localStorage 'fogoneria:theme'.
 * Primera visita sin valor la resuelve el script anti-FOUC de BaseLayout
 * vía prefers-color-scheme.
 */
interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  id={id}
  aria-label="Cambiar a modo oscuro"
  class="p-2 text-ink-400 hover:text-ink-900 hover:bg-primary-hover/[0.05] rounded-full transition-colors cursor-pointer"
>
  <svg
    class="icon-moon dark:hidden"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
  </svg>
  <svg
    class="icon-sun hidden dark:block"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2" />
    <path d="M12 20v2" />
    <path d="m4.93 4.93 1.41 1.41" />
    <path d="m17.66 17.66 1.41 1.41" />
    <path d="M2 12h2" />
    <path d="M20 12h2" />
    <path d="m6.34 17.66-1.41 1.41" />
    <path d="m19.07 4.93-1.41 1.41" />
  </svg>
</button>

<script>
  function syncThemeToggleLabels() {
    const isDark = document.documentElement.classList.contains("dark");
    document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
      btn.setAttribute(
        "aria-label",
        isDark ? "Cambiar a modo claro" : "Cambiar a modo oscuro",
      );
    });
  }

  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("fogoneria:theme", isDark ? "dark" : "light");
    } catch {
      /* almacenamiento no disponible */
    }
    syncThemeToggleLabels();
  }

  document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
    if (!(btn as HTMLElement).dataset.themeToggleBound) {
      (btn as HTMLElement).dataset.themeToggleBound = "true";
      btn.addEventListener("click", toggleTheme);
    }
  });

  syncThemeToggleLabels();
</script>
