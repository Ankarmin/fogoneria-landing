---
import { Image } from "astro:assets";
import { reviews } from "../../lib/landing";
import SectionHeader from "../ui/SectionHeader.astro";

const all = [...reviews, ...reviews];
---

<section id="reviews" class="py-16 bg-surface relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      eyebrow="Casos de Éxito"
      title="Restaurantes que ya se digitalizaron"
      description="No confíes solo en nuestra palabra. Descubre cómo Fogonería está ayudando a locales gastronómicos a modernizar su servicio."
    />

    <div class="relative w-full overflow-hidden pb-4">
      <div class="absolute top-0 left-0 w-16 h-full bg-gradient-to-r from-surface to-transparent z-10 pointer-events-none"></div>
      <div class="absolute top-0 right-0 w-16 h-full bg-gradient-to-l from-surface to-transparent z-10 pointer-events-none"></div>

      <div class="animate-marquee flex gap-4 px-4">
        {all.map((review, index) => (
          <div class="w-[320px] shrink-0 bg-surface rounded-2xl p-4 border border-ink-900/10 transition-all flex flex-col">
            <div class="flex gap-1 mb-3" aria-label={`${review.rating} de 5 estrellas`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20" class={i < review.rating ? "text-ink-900" : "text-ink-900/15"} aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <blockquote class="text-ink-600 text-sm leading-relaxed mb-6 flex-1">
              &ldquo;{review.quote}&rdquo;
            </blockquote>

            <div class="flex items-center gap-3 mt-auto">
              <Image src={review.image} alt={review.alt} width={40} height={40} widths={[40, 80]} class="w-10 h-10 rounded-full object-cover" loading="lazy" />
              <div>
                <p class="font-medium text-ink-900 text-nav">{review.name}</p>
                <p class="text-xs text-ink-400">{review.restaurant}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
