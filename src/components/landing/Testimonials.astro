---
import { reviews } from "../../lib/landing";
import SectionHeader from "../ui/SectionHeader.astro";

const all = [...reviews, ...reviews];
---

<section id="reviews" class="py-16 sm:py-24 lg:py-20 bg-gradient-to-b from-primary/[0.08] via-surface to-primary/[0.10] dark:from-black dark:via-persimmon-950/30 dark:to-black relative overflow-hidden scroll-mt-16">

  <!-- Esquinas visor — solo desktop -->
  <div class="absolute inset-4 sm:inset-6 z-10 hidden md:block pointer-events-none" aria-hidden="true">
    <span class="absolute top-0 left-0 w-6 h-6 border-t border-l border-ink-900/20 dark:border-white/30"></span>
    <span class="absolute top-0 right-0 w-6 h-6 border-t border-r border-ink-900/20 dark:border-white/30"></span>
    <span class="absolute bottom-0 left-0 w-6 h-6 border-b border-l border-ink-900/20 dark:border-white/30"></span>
    <span class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-ink-900/20 dark:border-white/30"></span>
  </div>

  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[36rem] h-[18rem] max-w-none bg-persimmon-200/40 dark:bg-transparent blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <SectionHeader
      display
      title="Restaurantes que ya se digitalizaron"
      description="No confíes solo en nuestra palabra. Descubre cómo Fogonería está ayudando a locales gastronómicos a modernizar su servicio."
    />

    <div class="relative w-full overflow-hidden pb-4 [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]">
      <div id="reviews-marquee" class="animate-marquee flex gap-3 sm:gap-4 px-4">
        {all.map((review, index) => {
          const initials = review.name
            .split(" ")
            .map((word) => word[0])
            .slice(0, 2)
            .join("");

          return (
          <div aria-hidden={index >= reviews.length ? "true" : undefined} class="w-[260px] min-[400px]:w-[280px] sm:w-[320px] shrink-0 bg-white dark:bg-white/[0.06] rounded-2xl p-4 border border-ink-900/15 dark:border-white/15 hover:border-primary/30 dark:hover:border-white/20 shadow-sm transition-all flex flex-col">
            <div class="flex gap-1 mb-3" role="img" aria-label={`${review.rating} de 5 estrellas`}>
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20" class={i < review.rating ? "text-primary" : "text-ink-900/10 dark:text-white/15"} aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
            </div>
            <blockquote class="text-ink-600 dark:text-white/70 text-sm leading-relaxed mb-6 flex-1">
              &ldquo;{review.quote}&rdquo;
            </blockquote>

            <div class="flex items-center gap-3 mt-auto pt-3 border-t border-ink-900/10 dark:border-white/10">
              <span aria-hidden="true" class="w-10 h-10 rounded-full bg-primary/10 text-primary dark:bg-white/10 dark:text-white flex items-center justify-center text-xs font-medium">
                {initials}
              </span>
              <div>
                <p class="font-medium text-ink-900 dark:text-white text-nav">{review.name}</p>
                <p class="text-xs text-ink-400">{review.restaurant}</p>
              </div>
            </div>
          </div>
          );
        })}
      </div>
    </div>

    <div class="mt-6 flex justify-center">
      <button
        type="button"
        data-marquee-toggle
        aria-controls="reviews-marquee"
        aria-pressed="false"
        class="inline-flex min-h-11 items-center justify-center rounded-full border border-ink-900/15 dark:border-white/20 px-4 py-2 text-xs font-medium text-ink-600 dark:text-white/70 hover:border-primary/50 hover:text-primary transition-colors cursor-pointer"
      >
        <span data-marquee-label>Pausar movimiento</span>
      </button>
    </div>
  </div>
</section>

<script>
  const marquee = document.getElementById("reviews-marquee");
  const toggle = document.querySelector("[data-marquee-toggle]");
  const label = toggle?.querySelector("[data-marquee-label]");

  if (marquee && toggle) {
    toggle.addEventListener("click", () => {
      const paused = marquee.classList.toggle("is-paused");
      toggle.setAttribute("aria-pressed", String(paused));
      if (label) label.textContent = paused ? "Reanudar movimiento" : "Pausar movimiento";
    });
  }
</script>
