---
import SectionHeader from "../ui/SectionHeader.astro";

const steps = [
  {
    number: "01",
    title: "Regístrate y sube tu material",
    description: "Crea tu cuenta en segundos y compártenos tu menú, logo y fotos del local directamente desde tu panel. Sin intermediarios.",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />',
  },
  {
    number: "02",
    title: "Abona el 50% inicial",
    description: "Formaliza el proyecto realizando el pago de la mitad del servicio. Esto activa a nuestro equipo para empezar a ensamblar tu web.",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />',
  },
  {
    number: "03",
    title: "Revisión y Feedback",
    description: "Te presentaremos una versión de prueba de tu sitio web. Podrás revisarla, probarla y darnos tus comentarios.",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />',
  },
  {
    number: "04",
    title: "Aprobación y Lanzamiento",
    description: "Una vez que des el visto bueno, cancelas el saldo restante y publicamos tu página en tu propio dominio.",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />',
  },
];
---

<section id="how-it-works" class="py-16 bg-persimmon-950 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <SectionHeader
      dark
      eyebrow="Proceso de Trabajo"
      title="Lanza tu web en 4 simples pasos"
      description="Un proceso diseñado para que tú sigas cocinando mientras nosotros hacemos la magia técnica."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 relative">
      {steps.map((step) => (
        <div class="relative group">
          <div class="bg-surface/5 border border-white/10 rounded-2xl p-4 hover:bg-surface/10 transition-all duration-300 h-full flex flex-col">
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 bg-surface rounded-xl flex items-center justify-center text-ink-900 group-hover:scale-105 transition-transform">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={step.icon} />
              </div>
              <span class="text-section font-medium text-white/10">{step.number}</span>
            </div>
            <h3 class="text-sm font-medium text-white mb-2">{step.title}</h3>
            <p class="text-nav text-white/60 leading-relaxed flex-1">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
