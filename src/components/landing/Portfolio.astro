---
import { Image } from "astro:assets";
import { demos } from "../../lib/landing";
import SectionHeader from "../ui/SectionHeader.astro";
---

<section id="demos" class="py-16 bg-surface relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeader
      title="Sitios web que abren el apetito"
      description="Explora nuestras plantillas optimizadas para conversión. Haz clic en cualquiera de ellas para interactuar con una demostración en vivo."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {demos.map((demo) => (
        <a href={demo.link} target="_blank" rel="noopener" class="group block bg-surface rounded-2xl border border-ink-900/10 transition-all duration-300 overflow-hidden flex flex-col">
          <div class="relative aspect-[4/3] overflow-hidden bg-primary/[0.04]">
            <Image src={demo.image} alt={demo.alt} widths={[400, 600, 800]} sizes="(max-width: 768px) 100vw, 33vw" class="object-cover w-full h-full transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <span class="px-5 h-10 inline-flex items-center bg-surface text-ink-900 text-sm font-medium rounded-full">
                Ver Sitio Web
              </span>
            </div>
          </div>

          <div class="p-4 flex-1 flex flex-col">
            <h3 class="text-sm font-medium text-ink-900 mb-1 transition-colors">
              {demo.title}
            </h3>
            <p class="text-nav text-ink-600 mb-4 flex-1">{demo.category}</p>

            <div class="flex flex-wrap gap-2 mt-auto pt-3 border-t border-ink-900/[0.06]">
              {demo.tags.map((tag) => (
                <span class="px-2 py-1 bg-primary/[0.05] text-ink-600 text-xs font-medium rounded-md">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
