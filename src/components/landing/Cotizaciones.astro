---
import SectionHeader from "../ui/SectionHeader.astro";

const inputCls = "h-12 rounded-xl border border-field bg-white dark:bg-white/5 px-4 text-base sm:text-sm text-ink-900 dark:text-white placeholder:text-ink-400 dark:placeholder:text-white/60 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30 w-full transition-colors";
---

<section id="cotizaciones" class="py-16 sm:py-24 bg-gradient-to-b from-primary/[0.10] via-primary/[0.12] to-surface dark:from-black dark:via-black dark:to-persimmon-950/60 relative overflow-hidden scroll-mt-16">
  <div class="absolute inset-4 sm:inset-6 z-10 hidden md:block pointer-events-none" aria-hidden="true">
    <span class="absolute top-0 left-0 w-6 h-6 border-t border-l border-ink-900/20 dark:border-white/30"></span>
    <span class="absolute top-0 right-0 w-6 h-6 border-t border-r border-ink-900/20 dark:border-white/30"></span>
    <span class="absolute bottom-0 left-0 w-6 h-6 border-b border-l border-ink-900/20 dark:border-white/30"></span>
    <span class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-ink-900/20 dark:border-white/30"></span>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
    <div class="min-w-0">
      <SectionHeader
        align="left"
        display
        title="Cotiza tu sistema"
        description="Cuéntanos cómo opera tu restaurante y te armamos una propuesta clara, sin compromiso."
      />
      <ul class="mt-6 flex flex-col gap-3 text-sm leading-relaxed text-ink-600 dark:text-white/70">
        <li class="flex items-start gap-3">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
          Te contactamos para entender la operación de tu restaurante.
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
          Propuesta con módulos, sucursales y puesta en marcha.
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
          Sin costo y con respuesta en menos de 24 horas.
        </li>
      </ul>
    </div>

    <div class="bg-white dark:bg-white/[0.06] rounded-2xl border border-primary/40 dark:border-white/15 p-4 sm:p-6 min-w-0">
      <form id="cotizacion-form" method="post" action="/api/cotizacion" class="grid grid-cols-1 xl:grid-cols-2 gap-4">
        <div class="hidden">
          <label for="cot-website">No completar este campo</label>
          <input id="cot-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="flex flex-col gap-2">
          <label for="cot-nombre" class="text-sm font-medium text-ink-900 dark:text-white">Nombre*</label>
          <input id="cot-nombre" name="nombre" type="text" required maxlength="80" placeholder="Ingresa tu nombre" class={inputCls} autocomplete="given-name" aria-describedby="cotizacion-error" />
        </div>
        <div class="flex flex-col gap-2">
          <label for="cot-apellido" class="text-sm font-medium text-ink-900 dark:text-white">Apellido*</label>
          <input id="cot-apellido" name="apellido" type="text" required maxlength="80" placeholder="Ingresa tu apellido" class={inputCls} autocomplete="family-name" aria-describedby="cotizacion-error" />
        </div>
        <div class="flex flex-col gap-2">
          <label for="cot-telefono" class="text-sm font-medium text-ink-900 dark:text-white">Teléfono de contacto*</label>
          <input id="cot-telefono" name="telefono" type="tel" required maxlength="25" placeholder="+51 911 234 567" class={inputCls} autocomplete="tel" aria-describedby="cotizacion-error" />
        </div>
        <div class="flex flex-col gap-2">
          <label for="cot-email" class="text-sm font-medium text-ink-900 dark:text-white">Email*</label>
          <input id="cot-email" name="email" type="email" required maxlength="254" placeholder="Ingresa tu correo" class={inputCls} autocomplete="email" aria-describedby="cotizacion-error" />
        </div>
        <div class="flex flex-col gap-2">
          <label for="cot-negocio" class="text-sm font-medium text-ink-900 dark:text-white">Nombre del negocio*</label>
          <input id="cot-negocio" name="negocio" type="text" required maxlength="120" placeholder="Nombre del restaurante" class={inputCls} autocomplete="organization" aria-describedby="cotizacion-error" />
        </div>
        <div class="flex flex-col gap-2">
          <label for="cot-sucursales" class="text-sm font-medium text-ink-900 dark:text-white">Cantidad de sucursales*</label>
          <select id="cot-sucursales" name="sucursales" required class={inputCls} aria-describedby="cotizacion-error">
            <option value="" disabled selected>Elige cantidad</option>
            <option value="1">1 local</option>
            <option value="2-3">2 a 3 locales</option>
            <option value="4+">4 o más locales</option>
          </select>
        </div>
        <div class="xl:col-span-2 flex items-start gap-3">
          <input
            id="cot-consent"
            name="consent"
            type="checkbox"
            required
            aria-describedby="cotizacion-error"
            class="mt-0.5 h-4 w-4 shrink-0 rounded border-field accent-primary"
          />
          <div class="text-xs leading-relaxed text-ink-600 dark:text-white/60">
            <label for="cot-consent">Acepto el tratamiento de mis datos para recibir una cotización.</label>
            <a href="/privacidad/" target="_blank" rel="noopener noreferrer" class="ml-1 underline underline-offset-2 hover:text-ink-900 dark:hover:text-white">Leer política de privacidad<span class="sr-only"> (abre en una pestaña nueva)</span></a>.
          </div>
        </div>
        <div class="xl:col-span-2 flex flex-col gap-3 mt-2">
          <p id="cotizacion-error" role="alert" class="hidden text-xs font-medium text-danger text-center"></p>
          <button id="cotizacion-submit" type="submit" class="bg-primary text-on-primary hover:bg-primary-hover disabled:opacity-60 disabled:cursor-not-allowed rounded-full px-5 h-10 min-h-11 w-full inline-flex items-center justify-center text-sm font-medium transition-all cursor-pointer">
            Solicitar cotización
          </button>
          <p class="text-xs text-ink-600 dark:text-white/60 text-center">Sin compromiso. Te contactamos en menos de 24 horas.</p>
        </div>
      </form>
      <noscript>
        <p class="mt-4 text-xs leading-relaxed text-ink-600 dark:text-white/60">
          Para enviar la solicitud, activa JavaScript en tu navegador.
        </p>
      </noscript>
      <div id="cotizacion-exito" class="hidden text-center py-8" aria-live="polite" tabindex="-1">
        <div class="w-12 h-12 rounded-full bg-primary text-on-primary flex items-center justify-center mx-auto mb-4">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
        </div>
        <p class="text-sm font-medium text-ink-900 dark:text-white mb-2">¡Gracias! Te contactaremos en menos de 24 horas.</p>
        <p class="text-nav text-ink-600 dark:text-white/60">Recibimos los datos de tu restaurante y ya estamos armando tu propuesta.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("cotizacion-form") as HTMLFormElement | null;
  const exito = document.getElementById("cotizacion-exito");
  const errorBox = document.getElementById("cotizacion-error");
  const submitBtn = document.getElementById("cotizacion-submit") as HTMLButtonElement | null;

  if (form && exito && errorBox && submitBtn) {
    const defaultLabel = submitBtn.textContent ?? "Solicitar cotización";

    const clearFieldErrors = () => {
      form
        .querySelectorAll<HTMLElement>("input, select")
        .forEach((field) => field.removeAttribute("aria-invalid"));
    };

    const markInvalidField = (message: string) => {
      const map: Array<[string, string]> = [
        ["correo", "cot-email"],
        ["teléfono", "cot-telefono"],
        ["telefono", "cot-telefono"],
        ["sucursales", "cot-sucursales"],
        ["consentimiento", "cot-consent"],
      ];
      const match = map.find(([needle]) =>
        message.toLowerCase().includes(needle),
      );
      const field = match ? document.getElementById(match[1]) : null;

      if (field) {
        field.setAttribute("aria-invalid", "true");
        field.focus();
      }
    };

    form.querySelectorAll<HTMLElement>("input, select").forEach((field) => {
      field.addEventListener("input", () =>
        field.removeAttribute("aria-invalid"),
      );
      field.addEventListener("change", () =>
        field.removeAttribute("aria-invalid"),
      );
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      clearFieldErrors();
      errorBox.textContent = "";
      errorBox.classList.add("hidden");
      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando solicitud...";
      form.setAttribute("aria-busy", "true");

      const formData = new FormData(form);
      const payload = {
        nombre: String(formData.get("nombre") ?? "").trim(),
        apellido: String(formData.get("apellido") ?? "").trim(),
        telefono: String(formData.get("telefono") ?? "").trim(),
        email: String(formData.get("email") ?? "").trim(),
        negocio: String(formData.get("negocio") ?? "").trim(),
        sucursales: String(formData.get("sucursales") ?? "").trim(),
        consent: formData.get("consent") === "on",
        website: String(formData.get("website") ?? "").trim(),
      };

      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 15_000);

      try {
        const response = await fetch("/api/cotizacion", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });

        const data = await response.json().catch(() => null);

        if (!response.ok || !data?.ok) {
          throw new Error(
            data?.error ?? "No pudimos enviar tu solicitud. Intenta nuevamente.",
          );
        }

        form.reset();
        form.classList.add("hidden");
        exito.classList.remove("hidden");
        exito.focus();
      } catch (err) {
        const message =
          err instanceof DOMException && err.name === "AbortError"
            ? "La solicitud tardó demasiado. Revisa tu conexión e intenta nuevamente."
            : err instanceof Error
              ? err.message
              : "Ocurrió un error al enviar tu solicitud. Intenta nuevamente.";

        errorBox.classList.remove("hidden");
        errorBox.textContent = message;
        markInvalidField(message);
      } finally {
        window.clearTimeout(timeout);
        submitBtn.disabled = false;
        submitBtn.textContent = defaultLabel;
        form.removeAttribute("aria-busy");
        if (document.activeElement === document.body) submitBtn.focus();
      }
    });
  }
</script>
